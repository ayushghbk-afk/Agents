AI_PROXY_URL=https://your-openai-compatible-endpoint.example/v1
AI_MODEL=your-model-name
AI_API_KEY=
WORKSPACE=.
MAX_OUTPUT_TOKENS=5000
TEMPERATURE=0.15
MAX_STEPS=60
COMMAND_TIMEOUT_MS=120000
REQUEST_TIMEOUT_MS=120000
AI_RETRIES=3
AUTO_APPROVE_SAFE=true
ALLOW_NETWORK=false
CHECKPOINTS=true
# Keep a private copy of each existing file immediately before agent edits it.
BACKUPS=true
MAX_BACKUPS=25
MAX_FILE_BYTES=500000
MAX_TOOL_OUTPUT=20000
MEMORY_MAX_ITEMS=250
MEMORY_RECALL_ITEMS=12
CONVERSATION_WINDOW=24
IGNORED_DIRS=node_modules,.git,.cache,__pycache__,dist,build,.agent,.venv
