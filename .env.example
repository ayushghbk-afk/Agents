# Provider: custom | openai | groq | gemini | local
MODEL_PROVIDER=custom
MODEL=openai/gpt-oss-120b
API_URL=https://your-openai-compatible-endpoint.example/v1
AI_API_KEY=
# Optional comma-separated fallback models
AI_FALLBACK_MODELS=

# Backward-compatible aliases
# AI_PROXY_URL=
# AI_MODEL=

WORKSPACE=.
MAX_OUTPUT_TOKENS=5000
TEMPERATURE=0.15
MAX_STEPS=60
COMMAND_TIMEOUT_MS=120000
REQUEST_TIMEOUT_MS=120000
AI_RETRIES=3
CONTEXT_WINDOW=128000
TOKEN_BUDGET=24000
MAX_REPAIR_ATTEMPTS=3
PLAN_APPROVAL=false
AUTO_APPROVE_SAFE=true
ALLOW_NETWORK=false
CHECKPOINTS=true
# Keep a private copy of each existing file immediately before agent edits it.
BACKUPS=true
MAX_BACKUPS=25
MAX_FILE_BYTES=500000
MAX_TOOL_OUTPUT=20000
MEMORY_MAX_ITEMS=250
MEMORY_RECALL_ITEMS=12
CONVERSATION_WINDOW=24
IGNORED_DIRS=node_modules,.git,.cache,__pycache__,dist,build,.agent,.agents,.venv
