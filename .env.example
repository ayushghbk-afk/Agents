# Provider: custom | openai | groq | gemini | local
MODEL_PROVIDER=custom
MODEL=openai/gpt-oss-120b
API_URL=https://your-openai-compatible-endpoint.example/v1
AI_API_KEY=
# Optional comma-separated fallback models
AI_FALLBACK_MODELS=

# Backward-compatible aliases
# AI_PROXY_URL=
# AI_MODEL=

# Project the agent may edit. Prefer launching with:
#   node src/cli.js --workspace ~/projects/test-website
WORKSPACE=.
# Gemini-style session mode: fast | thinking | pro | auto | plan | debug | research | ask
AGENT_MODE=pro
MAX_OUTPUT_TOKENS=1000
TEMPERATURE=0.15
MAX_STEPS=60
COMMAND_TIMEOUT_MS=120000
REQUEST_TIMEOUT_MS=120000
AI_RETRIES=3
# The Groq proxy ceiling is ~8000 TPM. Keep request budgets well under it:
# target ~2500-4000 input tokens and ~500-1000 output tokens per request.
CONTEXT_WINDOW=4000
TOKEN_BUDGET=3500
MAX_REPAIR_ATTEMPTS=3
PLAN_APPROVAL=false
AUTO_APPROVE_SAFE=true
ALLOW_NETWORK=false
CHECKPOINTS=true
# Keep a private copy of each existing file immediately before agent edits it.
BACKUPS=true
MAX_BACKUPS=25
MAX_FILE_BYTES=500000
MAX_TOOL_OUTPUT=20000
MEMORY_MAX_ITEMS=250
MEMORY_RECALL_ITEMS=12
CONVERSATION_WINDOW=24
IGNORED_DIRS=node_modules,.git,.cache,__pycache__,dist,build,.agent,.agents,.venv
